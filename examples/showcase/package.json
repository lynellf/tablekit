{
  "name": "tablekit-examples",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "storybook dev --port 5176 --no-open",
    "build": "tsc -b && storybook build --output-dir dist/client && node scripts/prepare-sites-output.mjs",
