  "dependencies": {
    "@lynellf/tablekit-core": "workspace:*",
    "@lynellf/tablekit-pivot": "workspace:*",
    "@lynellf/tablekit-react": "workspace:*",
    "@lynellf/tablekit-worker": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.4",
    "@storybook/addon-docs": "10.5.4",
    "@storybook/react-vite": "10.5.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "storybook": "10.5.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
