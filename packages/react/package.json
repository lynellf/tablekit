{
  "name": "@lynellf/tablekit-react",
  "version": "3.0.0",
  "private": false,
  "description": "Accessible, batteries-included React DataGrid and PivotGrid components backed by TanStack.",
  "type": "module",
  "main": "./dist/tablekit-react.es.js",
  "module": "./dist/tablekit-react.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tablekit-react.es.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.es.js"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lynellf/table-kit"
  },
  "bugs": {
    "url": "https://github.com/lynellf/table-kit/issues"
  },
  "homepage": "https://github.com/lynellf/table-kit",
  "keywords": ["react", "table", "data-grid", "pivot-grid", "tanstack"],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "vite build && pnpm build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:subpaths": "node vite.subpaths.config.mjs",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@lynellf/tablekit-pivot": "workspace:^",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "jsdom": "^25.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
