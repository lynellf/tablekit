{
  "name": "@lynellf/tablekit-pivot",
  "version": "3.0.0",
  "private": false,
  "description": "Framework-free pivot algorithms with main-thread, worker, and server execution.",
  "type": "module",
  "main": "./dist/tablekit-pivot.es.js",
  "module": "./dist/tablekit-pivot.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tablekit-pivot.es.js"
    },
    "./aggregators": {
      "types": "./dist/aggregators/index.d.ts",
      "import": "./dist/aggregators/index.es.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.es.js"
    },
    "./serialize": {
      "types": "./dist/serialize/index.d.ts",
      "import": "./dist/serialize/index.es.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.es.js"
    },
    "./worker/entry": {
      "types": "./dist/worker/entry/index.d.ts",
      "import": "./dist/worker/entry/index.es.js"
    },
    "./worker/protocol": {
      "types": "./dist/worker/protocol/index.d.ts",
      "import": "./dist/worker/protocol/index.es.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.es.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lynellf/table-kit"
  },
  "bugs": {
    "url": "https://github.com/lynellf/table-kit/issues"
  },
  "homepage": "https://github.com/lynellf/table-kit",
  "keywords": ["pivot", "aggregation", "worker", "server", "tree"],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "vite build && pnpm build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:subpaths": "node vite.subpaths.config.mjs",
    "typecheck": "tsc -b",
    "bench": "vitest bench --run bench/main-thread.bench.ts"
  }
}
